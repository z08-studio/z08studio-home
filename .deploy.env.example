# Copy to .deploy.env and keep actual infrastructure details out of Git.
Z08_DEPLOY_HOST=your-vultr-ssh-alias
Z08_DEPLOY_ROOT=/srv/z08studio-home
Z08_DOCKER_NETWORK=your-existing-gateway-network
# Used for the one-time HTTPS gateway setup documented in deploy/README.md.
Z08_GATEWAY_CONTAINER=your-existing-caddy-container
Z08_GATEWAY_CONFIG=/path/to/your/Caddyfile
