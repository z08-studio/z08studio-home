---
import Arrow from './Arrow.astro';
import { studio } from '../data/studio';
interface Props { page: 'home' | 'about' | 'privacy'; }
const { page } = Astro.props;
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="z08 studio home">
    <img src="/images/z08-black.svg" alt="" width="66" height="28" />
    <span>studio</span>
  </a>
  <nav aria-label="Main navigation">
    <a href={page === 'home' ? '#projects' : '/#projects'}>Projects</a>
    <a href="/about/" aria-current={page === 'about' ? 'page' : undefined}>About</a>
    <a class="nav-github" href={studio.github} target="_blank" rel="noopener noreferrer">GitHub<Arrow /><span class="sr-only"> (opens in a new tab)</span></a>
  </nav>
</header>
