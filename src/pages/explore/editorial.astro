---
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import Brand from '../../components/explore/Brand.astro';
import ProductIcon from '../../components/explore/ProductIcon.astro';
import Arrow from '../../components/Arrow.astro';
import { projects, studio } from '../../data/studio';
import '../../styles/explore/editorial.css';
---
<ConceptLayout concept="editorial">
  <div class="editorial-shell" id="top">
    <header class="editorial-header">
      <Brand />
      <nav class="concept-nav" aria-label="Main navigation">
        <a href="#projects">Projects</a><a href="#about">About</a>
        <a class="nav-external" href={studio.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">GitHub <Arrow /></a>
      </nav>
    </header>
    <main id="main">
      <section class="editorial-hero" aria-labelledby="editorial-title">
        <div class="editorial-headline">
          <h1 id="editorial-title">One thing.<br /><em>Done well.</em></h1>
          <div class="editorial-emblem" aria-hidden="true"><span>Z</span><i></i></div>
        </div>
        <div class="editorial-intro">
          <p>Small tools for real needs. Each one does one job, shaped by everyday use and refined with care.</p>
          <a href="#projects">Explore the projects <span><Arrow direction="down" /></span></a>
        </div>
      </section>
      <section class="editorial-projects" id="projects" aria-labelledby="editorial-projects-title">
        <h2 id="editorial-projects-title">Our projects</h2>
        {projects.map(project => (
          <article class="editorial-project">
            <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} (opens in a new tab)`}>
              <div class="editorial-project-icon"><ProductIcon project={project} size={80} /></div>
              <div class="editorial-project-title"><h3>{project.name}</h3><span>{project.category}</span></div>
              <p>{project.description}</p>
              <span class="editorial-project-arrow"><Arrow /></span>
            </a>
          </article>
        ))}
      </section>
      <section class="editorial-about" id="about" aria-labelledby="editorial-about-title">
        <div><h2 id="editorial-about-title">Hi, I’m Bear.</h2><p class="editorial-about-lead">I make the tools<br /><em>I wish I could find.</em></p></div>
        <div class="editorial-story">
          <p>These projects started with things I needed to do and tools that never quite fit. So I built my own.</p>
          <p>I use them, notice the rough edges, and keep working on the details. I hope you find them useful, too.</p>
          <a href={studio.author.github} target="_blank" rel="noopener noreferrer" aria-label="Find Bear on GitHub (opens in a new tab)">Find me on GitHub <Arrow /></a>
        </div>
      </section>
      <aside class="editorial-naming" aria-label="About the Z names"><span aria-hidden="true">Z</span><p>Naming things is hard. That’s why most of my tools start with Z.</p></aside>
    </main>
    <footer class="concept-footer editorial-footer"><Brand /><div><span>© {new Date().getFullYear()} z08 studio</span><a href="#top">Back to top <Arrow direction="up" /></a></div></footer>
  </div>
</ConceptLayout>
